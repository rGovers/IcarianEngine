#version 450

layout(location = 0) in vec2 vUV;

#!texture(0, colorSampler)
#!texture(1, normalSampler)
#!texture(2, specSampler)
#!texture(3, emissionSampler)
#!texture(4, depthSampler)
#!shadowtexturearray(5, 6, shadowSampler)

#!structure(CameraBuffer, 6, camBuffer)
#!structure(DirectionalLightBuffer, 7, dirLightBuffer)
#!structure(SSShadowLightBuffer, 8, shadowLightBuffer)

#!import(DirectionalLight)

layout(location = 0) out vec4 fragColor;

void main()
{
    vec4 normal = texture(normalSampler, vUV);
    if (normal.w < 0.5)
    {
        discard;
    }

    float depth = texture(depthSampler, vUV).x;

    vec2 oUV = fma(vUV, vec2(2.0), vec2(-1.0));

    vec4 cP = vec4(oUV, depth, 1.0);
    vec4 vP = camBuffer.InvProj * cP;
    vP /= vP.w;
    vec4 mP = camBuffer.InvView * vP;

    #!preloop(iter, 0, 6,
    {
        if (-vP.z <= shadowLightBuffer.objects[iter].Split)
        {
            // Finally figured out what was causing the visual artifacts on AMD GPUs
            // Turns out value inside branch != value outside of the branch 
            // This was really painful to debug as shader debuggers where showing the correct value
            // The only reason I was able to catch on is the artifacts where squarish
            // Had to write each value to the fragment and debug that way with the graphics debugger
            // Unlikely but not impossible to be the driver as it happens across OSs and Drivers on the OSs
            // This is a non issue on Nvidia GPUs they correctly set the exiting iterator value
            // NOTE: This occurs regardless of it being a preloop or a normal for loop
            // TLDR: When branching do all the work in the branch do not pass out the iterator value
            vec4 lP = shadowLightBuffer.objects[iter].LVP * mP;

            vec2 sP = fma(lP.xy, vec2(0.5), vec2(0.5));
            float sV = texture(shadowSampler[iter], sP).x;
            if (lP.z > sV)
            {
                discard;
            }

            break;
        }
    })

    vec3 p = camBuffer.InvView[3].xyz;
    vec3 cV = normalize(p - mP.xyz);

    vec4 color = texture(colorSampler, vUV);
    vec4 spec = texture(specSampler, vUV);
    float rough = spec.x;
    float metal = spec.y;

    fragColor = DirectionalLightShading(color, cV, normal.xyz, rough, metal, dirLightBuffer);
}